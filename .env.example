# Take It v2 — environment template. NAMES ONLY, never commit real values.

# Supabase (web client uses VITE_-prefixed public values only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only (edge functions / CI). NEVER in any client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Chapa (sandbox) — behind FEATURE_PAYMENTS_ENABLED
CHAPA_SECRET_KEY_TEST=
CHAPA_WEBHOOK_SECRET=

# Telegram auth (primary channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOGIN_DOMAIN=

# SMS OTP fallback
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Fayda eSignet (sandbox) — behind FEATURE_FAYDA_ENABLED
FAYDA_ESIGNET_CLIENT_ID=
FAYDA_ESIGNET_REDIRECT_URI=

# Feature flags
FEATURE_PAYMENTS_ENABLED=false
FEATURE_FAYDA_ENABLED=false

# Web client (public — safe for the browser). Only VITE_-prefixed vars reach
# the browser bundle; never prefix a secret with VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_FEATURE_PAYMENTS_ENABLED=false
VITE_FEATURE_FAYDA_ENABLED=false
# "Talk to Take It" support entry (N12) — a t.me/... URL; founder supplies
# the real handle. Public value, still names-only here (R5).
VITE_SUPPORT_TELEGRAM_URL=
